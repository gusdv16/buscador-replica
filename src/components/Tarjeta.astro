---
const { o, i = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
const iniciales = o.nombre.replace(/[^\p{L}\s]/gu, '').split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
const texto = `${o.nombre} ${o.descripcion} ${o.categoriaNombre} ${o.zonas.join(' ')}`;
---
<a
  class="tarjeta"
  href={`${base}ofertas/${o.slug}/`}
  data-i={i}
  data-nombre={o.nombre}
  data-texto={texto}
  data-cat={o.categoria}
  data-zonas={o.zonas.join('|')}
  data-dias={o.dias.join('|')}
  data-dto={o.dto}
  data-vence={o.vigencia}
>
  <span class="insignia">{o.etiqueta}</span>
  <span class={`monograma t-${o.categoria}`} aria-hidden="true">{iniciales}</span>
  <h3>{o.nombre}</h3>
  <div class="cat">{o.categoriaNombre}</div>
  <p class="desc">{o.descripcion}</p>
  <span class="donde">{o.zonas.join(' · ')}</span>
  <span class="mas" aria-hidden="true">+</span>
</a>
