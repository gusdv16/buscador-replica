---
import Base from '../layouts/Base.astro';
import Tarjeta from '../components/Tarjeta.astro';
import datos from '../data/ofertas.json';
const base = import.meta.env.BASE_URL;
const { categorias, zonas, ofertas } = datos;
const dias = ['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo'];
const iconos = { moda: '👗', tecnologia: '🎧', hogar: '🛋️', gastronomia: '🍕', 'salud-belleza': '🌿', deportes: '🚲', libros: '📚', mascotas: '🐾', ocio: '🎲' };
const slides = ['gastronomia', 'deportes', 'hogar', 'libros', 'ocio'];
const cuenta = (id) => ofertas.filter((o) => o.categoria === id).length;
const destacadas = ofertas.filter((o) => o.destacada).slice(0, 8);
---
<Base>
  <section class="hero" aria-roledescription="carrusel" aria-label="Ofertas de tiendas">
    <div class="slides" aria-hidden="true">
      {slides.map((id, n) => (
        <div class={`slide${n === 0 ? ' activa' : ''}`}>
          <img
            src={`${base}img/h/${id}-1400.webp`}
            srcset={`${base}img/h/${id}-800.webp 640w, ${base}img/h/${id}-1400.webp 1280w`}
            sizes="100vw" alt="" width="1400" height="700"
            loading={n === 0 ? 'eager' : 'lazy'} fetchpriority={n === 0 ? 'high' : 'auto'} decoding="async"
          />
        </div>
      ))}
    </div>
    <div class="hero-velo"></div>
    <div class="slider-ctrl" id="slider-ctrl">
      <button class="flecha" type="button" id="s-ant" aria-label="Imagen anterior">‹</button>
      <div class="puntos">{slides.map((_, n) => <button class="punto" type="button" data-n={n} aria-label={`Ir a la imagen ${n + 1}`} aria-current={n === 0 ? 'true' : 'false'}></button>)}</div>
      <button class="flecha" type="button" id="s-sig" aria-label="Imagen siguiente">›</button>
    </div>
    <div class="contenedor">
      <span class="hero-etiqueta">Ofertas de tiendas de barrio</span>
      <h1>Las mejores <span class="grande">chiripas</span> cerca tuyo</h1>
      <p>Descuentos y 2x1 de tiendas, cafés y talleres de tu zona. Buscá, elegí y mostrá el código en caja.</p>
    </div>
  </section>

  <div class="contenedor">
    <form class="tarjeta-busqueda" action={`${base}ofertas/`} method="get">
      <h2>¡Encontrá la oferta que buscás!</h2>
      <div class="campos">
        <div class="campo">
          <label for="q">Qué buscás</label>
          <input id="q" name="q" type="search" placeholder="Pizza, zapatillas, bicicleta…" autocomplete="off" />
        </div>
        <div class="campo">
          <label for="cat">Categoría</label>
          <select id="cat" name="cat">
            <option value="">Todas</option>
            {categorias.map((c) => <option value={c.id}>{c.nombre}</option>)}
          </select>
        </div>
        <div class="campo">
          <label for="zona">Zona</label>
          <select id="zona" name="zona">
            <option value="">Todas</option>
            {zonas.map((z) => <option value={z}>{z}</option>)}
          </select>
        </div>
        <div class="campo">
          <label for="dia">Día</label>
          <select id="dia" name="dia">
            <option value="">Cualquiera</option>
            {dias.map((d) => <option value={d}>{d.charAt(0).toUpperCase() + d.slice(1)}</option>)}
          </select>
        </div>
        <button class="boton" type="submit">Buscar</button>
      </div>
    </form>
  </div>

  <section class="seccion">
    <div class="contenedor">
      <h2 class="titulo-seccion titulo-centro">Ofertas de tiendas para todos los gustos</h2>
      <p class="subtitulo">Elegí una categoría y mirá qué hay en tu zona.</p>
      <div class="categorias">
        {categorias.map((c) => (
          <a class={`categoria`} href={`${base}ofertas/?cat=${c.id}`}>
            <img class="foto" src={`${base}img/c/${c.id}-0.webp`} alt="" width="400" height="270" loading="lazy" decoding="async" />
            {c.nombre}
            <small>{cuenta(c.id)} ofertas</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion" style="padding-top:0">
    <div class="contenedor">
      <div class="banners">
        <a class="banner a" href={`${base}ofertas/?orden=mayor`}><strong>Hasta 40%</strong><span>Las ofertas con mayor descuento, ordenadas para vos</span></a>
        <a class="banner b" href={`${base}ofertas/?q=2x1`}><strong>2x1</strong><span>Comé, mirá y jugá de a dos pagando uno</span></a>
      </div>
      <h2 class="titulo-seccion">Ofertas destacadas</h2>
      <p class="subtitulo">Una selección de las chiripas de la semana.</p>
      <div class="grilla">
        {destacadas.map((o) => <Tarjeta o={o} />)}
      </div>
      <a class="boton boton-verde ver-mas" style="width:fit-content" href={`${base}ofertas/`}>Ver las {ofertas.length} ofertas</a>
    </div>
  </section>

  <section class="seccion seccion-gris" id="como-funciona">
    <div class="contenedor">
      <h2 class="titulo-seccion titulo-centro">Cómo funciona</h2>
      <p class="subtitulo">Tres pasos y listo. Sin registro y sin datos personales.</p>
      <div class="pasos">
        <div class="paso"><h3>Buscá</h3><p>Escribí lo que querés o filtrá por categoría, zona y día de la semana.</p></div>
        <div class="paso"><h3>Elegí</h3><p>Abrí la ficha de la oferta y revisá condiciones, días y vigencia.</p></div>
        <div class="paso"><h3>Mostrá el código</h3><p>Dalo en caja o ingresalo al comprar online. Así de simple.</p></div>
      </div>
    </div>
  </section>
</Base>

<script>
  const slides = Array.from(document.querySelectorAll('.slide'));
  const puntos = Array.from(document.querySelectorAll('.punto'));
  let actual = 0, timer;
  const ir = (n) => {
    actual = (n + slides.length) % slides.length;
    slides.forEach((s, i) => s.classList.toggle('activa', i === actual));
    puntos.forEach((p, i) => p.setAttribute('aria-current', i === actual));
  };
  const auto = () => { clearInterval(timer); if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(() => ir(actual + 1), 5500); };
  document.getElementById('s-ant').addEventListener('click', () => { ir(actual - 1); auto(); });
  document.getElementById('s-sig').addEventListener('click', () => { ir(actual + 1); auto(); });
  puntos.forEach((p) => p.addEventListener('click', () => { ir(+p.dataset.n); auto(); }));
  document.getElementById('slider-ctrl').addEventListener('focusin', () => clearInterval(timer));
  auto();
</script>
